# =====================================================================
#  air-ground-cooperative-mmr — root .gitignore
#  MMR / GCS / Drone 세 파트 + STM32 펌웨어 공통 규칙
# =====================================================================

# ---------------------------------------------------------------------
# ROS 2 / colcon 빌드 산출물 (MMR, GCS, Drone 모든 워크스페이스)
# ---------------------------------------------------------------------
build/
install/
log/

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# 가상환경
.venv/
venv/
env/

# ---------------------------------------------------------------------
# 개발 중 생성된 백업 / 디버깅 산출물
#   예) gcs_ui.py.bak_mission_sync_20260709_211609
#       gcs_ui.py.before_lgma_20260713_165635
#       mission_manager_before_single_fc_20260708_154049.py
#       _pre_mmr_patch_backup/
# ---------------------------------------------------------------------
*.bak
*.bak_*
*.bak[0-9]*
*.orig
*.rej
*.py.before_*
*_before_*_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9]*.py
_pre_*_backup/
*_backup/

# ---------------------------------------------------------------------
# STM32CubeIDE (MMR/firmware)
# ---------------------------------------------------------------------
# 빌드 출력 디렉터리 (.o .d .su .cyclo .elf .map .list 등)
Debug/
Release/
*.o
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.map
*.list
# 개인 PC 경로가 포함되는 디버그 실행 구성 / IDE 자동 생성 파일
MMR/firmware/**/*.launch
MMR/firmware/**/.settings/language.settings.xml
st-link_gdbserver_log.txt

# ---------------------------------------------------------------------
# MMR 전용
# ---------------------------------------------------------------------
# 제조사 IMU 드라이버/SDK는 재배포하지 않음 (MMR/vendor/README.md 참고)
MMR/src/stella_ahrs/
vendor_sdk/
third_party/vendor/
*.a
*.so
*.so.*

# 지형 DEM 래스터는 별도 제공 (MMR/data/README.md 참고)
*.tif
*.tiff

# ---------------------------------------------------------------------
# 실행 기록 / 로그 데이터
# ---------------------------------------------------------------------
bags/
*.db3
*.mcap
*.log

# ---------------------------------------------------------------------
# 비밀정보 (NTRIP 계정 등) — 절대 커밋 금지
# ---------------------------------------------------------------------
.env
.env.*
*.local.yaml
credentials.*
secrets.*
*.key
*.pem

# ---------------------------------------------------------------------
# IDE / 에디터 / OS
# ---------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
